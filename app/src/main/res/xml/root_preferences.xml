<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_category_video_title">
        <ListPreference
            android:key="car_orientation"
            android:title="@string/pref_car_orientation_title"
            android:summary="@string/pref_car_orientation_summary"
            android:entries="@array/car_orientation_entries"
            android:entryValues="@array/car_orientation_values"
            android:defaultValue="auto" />
        <ListPreference
            android:key="video_resolution_mode"
            android:title="@string/pref_video_resolution_mode_title"
            android:summary="@string/pref_video_resolution_mode_summary"
            android:entries="@array/resolution_mode_entries"
            android:entryValues="@array/resolution_mode_values"
            android:defaultValue="auto" />
        <EditTextPreference
            android:key="video_resolution_custom_width"
            android:title="@string/pref_video_resolution_custom_width_title"
            android:inputType="number" />
        <EditTextPreference
            android:key="video_resolution_custom_height"
            android:title="@string/pref_video_resolution_custom_height_title"
            android:inputType="number" />
        <ListPreference
            android:key="video_frame_rate"
            android:title="@string/pref_video_frame_rate_title"
            android:entries="@array/frame_rate_entries"
            android:entryValues="@array/frame_rate_values"
            android:defaultValue="30" />
        <EditTextPreference
            android:key="video_bitrate_kbps"
            android:title="@string/pref_video_bitrate_kbps_title"
            android:inputType="number"
            android:defaultValue="6000" />
        <SwitchPreferenceCompat
            android:key="video_dpi_auto"
            android:title="@string/pref_video_dpi_auto_title"
            android:summary="@string/pref_video_dpi_auto_summary"
            android:defaultValue="true" />
        <EditTextPreference
            android:key="video_dpi_manual"
            android:title="@string/pref_video_dpi_manual_title"
            android:summary="@string/pref_video_dpi_manual_summary"
            android:inputType="number"
            android:defaultValue="160" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_audio_title">
        <ListPreference
            android:key="audio_sample_rate"
            android:title="@string/pref_audio_sample_rate_title"
            android:entries="@array/sample_rate_entries"
            android:entryValues="@array/sample_rate_values"
            android:defaultValue="48000" />
        <SwitchPreferenceCompat
            android:key="audio_stereo"
            android:title="@string/pref_audio_stereo_title"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_android_auto_title">
        <Preference
            android:key="car_profiles"
            android:title="@string/pref_car_profiles_title"
            android:summary="@string/pref_car_profiles_summary" />
        <SwitchPreferenceCompat
            android:key="video_downscale_720p"
            android:title="@string/pref_video_downscale_720p_title"
            android:summary="@string/pref_video_downscale_720p_summary"
            android:defaultValue="true" />
        <ListPreference
            android:key="aa_fill_mode"
            android:title="@string/pref_aa_fill_mode_title"
            android:summary="@string/pref_aa_fill_mode_summary"
            android:entries="@array/aa_fill_mode_entries"
            android:entryValues="@array/aa_fill_mode_values"
            android:defaultValue="fit" />
        <ListPreference
            android:key="aa_audio_route"
            android:title="@string/pref_aa_audio_route_title"
            android:summary="@string/pref_aa_audio_route_summary"
            android:entries="@array/aa_audio_route_entries"
            android:entryValues="@array/aa_audio_route_values"
            android:defaultValue="phone_direct" />
        <SwitchPreferenceCompat
            android:key="aa_auto_crop"
            android:title="@string/pref_aa_auto_crop_title"
            android:summary="@string/pref_aa_auto_crop_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_connection_title">
        <SwitchPreferenceCompat
            android:key="auto_reconnect_usb"
            android:title="@string/pref_auto_reconnect_usb_title"
            android:summary="@string/pref_auto_reconnect_usb_summary"
            android:defaultValue="true" />
        <ListPreference
            android:key="usb_role_override"
            android:title="@string/pref_usb_role_override_title"
            android:summary="@string/pref_usb_role_override_summary"
            android:entries="@array/usb_role_entries"
            android:entryValues="@array/usb_role_values"
            android:defaultValue="auto" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_debug_title">
        <SwitchPreferenceCompat
            android:key="debug_verbose_logging"
            android:title="@string/pref_debug_verbose_logging_title"
            android:summary="@string/pref_debug_verbose_logging_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="debug_overlay"
            android:title="@string/pref_debug_overlay_title"
            android:summary="@string/pref_debug_overlay_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="auto_save_crash_log"
            android:title="@string/pref_auto_save_crash_log_title"
            android:summary="@string/pref_auto_save_crash_log_summary"
            android:defaultValue="true" />
        <Preference
            android:key="developer_tools"
            android:title="@string/pref_developer_tools_title"
            android:summary="@string/pref_developer_tools_summary" />
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
